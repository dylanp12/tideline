{
  "name": "@tideline/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript client for TLR/1 — record agent runs, gate high-risk actions on human approval, and verify the result offline. EU AI Act Articles 12 and 14.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/dylanp12/tideline",
  "repository": { "type": "git", "url": "git+https://github.com/dylanp12/tideline.git", "directory": "sdk/ts" },
  "keywords": ["ai-agents", "audit", "eu-ai-act", "human-in-the-loop", "oversight", "tamper-evident", "compliance"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "files": ["dist", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js", "require": "./dist/react.cjs" }
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
